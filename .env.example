# Copy to .env and edit. Every value is optional for local development:
# with no .env the app runs on SQLite with demo data.

APP_ENV=development            # development | production
FLASK_DEBUG=0
SECRET_KEY=change-me-to-a-long-random-string      # required in production (python -c "import secrets;print(secrets.token_hex(32))")
SESSION_COOKIE_SECURE=0        # set 1 when serving over HTTPS
PUBLIC_BASE_URL=http://127.0.0.1:5000

# --- Database -----------------------------------------------------------
# DB_ENGINE=sqlite             # default when no MYSQL_* variable is set
# SQLITE_PATH=instance/placement.db
# DB_ENGINE=mysql
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_USER=root
# MYSQL_PASSWORD=your_password
# MYSQL_DATABASE=placement_predictor

AUTO_INIT_DB=1                 # create/upgrade tables on startup
SEED_DEMO_DATA=1               # demo accounts and data (disabled by default in production)
# Create a first admin in production (only used when no admin exists):
# ADMIN_EMAIL=admin@your-college.edu
# ADMIN_PASSWORD=ChangeMe123

# --- Email (password reset, notifications). When off, mail is written to logs/outbox.log
MAIL_ENABLED=0
# MAIL_SERVER=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=you@gmail.com
# MAIL_PASSWORD=app-password
# MAIL_FROM=Placement Cell <you@gmail.com>

# --- Optional SMS gateway (JSON webhook: {"to": "...", "message": "..."}) ---
SMS_ENABLED=0
# SMS_WEBHOOK_URL=https://example.com/sms
